cabal-version: 3.0
name:          haskoin
version:       0.1.0.0
synopsis:      Bitcoin full node in Haskell
build-type:    Simple

-- W161 BUG-8: bundle the BIP-39 English wordlist into the installed
-- package so 'Haskoin.Wallet.loadBip39WordList' resolves it via
-- Paths_haskoin.getDataFileName, independent of the caller's CWD.
-- Cabal copies this file under the package's data dir at install time
-- (e.g. ~/.cabal/store/.../haskoin-0.1.0.0/resources/bip39-english.txt).
data-files:    resources/bip39-english.txt

library
  exposed-modules: Haskoin.Types
                 , Haskoin.Fatal
                 , Haskoin.TestHooks
                 , Haskoin.ChainLock
                 , Haskoin.Crypto
                 , Haskoin.Script
                 , Haskoin.Consensus
                 , Haskoin.Storage
                 , Haskoin.HeaderReload
                 , Haskoin.Network
                 , Haskoin.Sync
                 , Haskoin.Mempool
                 , Haskoin.Mempool.Persist
                 , Haskoin.Policy.Standard
                 , Haskoin.FeeEstimator
                 , Haskoin.BlockTemplate
                 , Haskoin.Rpc
                 , Haskoin.CoreArity
                 , Haskoin.Wallet
                 , Haskoin.Wallet.Persist
                 , Haskoin.Performance
                 , Haskoin.Index
                 , Haskoin.MuHash
                 , Haskoin.TaprootSighash
                 , Haskoin.Daemon
                 , Haskoin.TxOrphanage
                 , Haskoin.ASMap
                 , Haskoin.Bip21
                 , Haskoin.Payjoin
                 , System.ZMQ4
  -- W161 BUG-8: Paths_haskoin is auto-generated by Cabal and exposes
  -- getDataFileName for the data-files entry above.  Must appear in
  -- BOTH autogen-modules and other-modules (cabal-version >= 2.0).
  autogen-modules: Paths_haskoin
  other-modules:   Paths_haskoin
  hs-source-dirs:  src
  build-depends:   base >= 4.14 && < 5
                 , bytestring
                 , cereal
                 , hashable
                 , deepseq
                 , cryptonite
                 , memory
                 , text
                 , transformers
                 , rocksdb-haskell
                 , network
                 , stm
                 , time
                 , random
                 , containers
                 , resourcet
                 , aeson
                 , warp
                 , warp-tls
                 , wai
                 , http-types
                 , base16-bytestring
                 , base64-bytestring
                 , vector
                 , parallel
                 , async
                 , secp256k1-haskell
                 , mmap
                 , directory
                 , filepath
                 , unix
                 , scientific
                 -- FIX-66 (W119 BUG-3): sender-side HTTP POST + HTTPS for
                 -- BIP-78 PayJoin.  'http-client' provides the engine and
                 -- the 'http-client-tls' backend wires the TLS manager
                 -- (used by `sendPayjoinRequest` when the receiver's
                 -- `pj=` endpoint is HTTPS).  Both are long-standing
                 -- snoyberg packages with a stable API.
                 , http-client
                 , http-client-tls
  c-sources:       cbits/hwdetect.c
                 , cbits/secp256k1_compat.c
                 , cbits/zmq_stubs.c
                 , cbits/format_double.c
  cc-options:       -O2
  -- System dependencies: sudo apt install -y librocksdb-dev libsecp256k1-dev
  -- Also requires libminisketch (build from https://github.com/sipa/minisketch)
  -- RocksDB 9.x removed rocksdb_filterpolicy_create; rocksdb_compat is a shim
  -- that provides it. Build the shim with: scripts/build-rocksdb-compat.sh
  -- and install to /usr/local/lib or set extra-lib-dirs below.
  --
  -- ZMQ: we link directly against libzmq.so.5 (the runtime SONAME) using
  -- the GNU ld :exact-name syntax so that no <zmq.h> headers / libzmq3-dev
  -- package are required at build time. cbits/zmq_stubs.c forward-declares
  -- the libzmq 4.x ABI (stable per https://api.zeromq.org). This mirrors
  -- the camlcoin pattern (camlcoin/lib/dune commit 23c02ac).
  extra-libraries: minisketch stdc++ rocksdb_compat rocksdb secp256k1
                   :libzmq.so.5
  default-language: Haskell2010
  ghc-options:     -Wall -O2 -funbox-strict-fields

executable haskoin
  main-is:       Main.hs
  hs-source-dirs: app
  build-depends: base >= 4.14 && < 5
               , haskoin
               , optparse-applicative
               , text
               , bytestring
               , stm
               , containers
               , directory
               , filepath
               , base16-bytestring
               , cereal
               , network
               , unix
               , wai
               , warp
               , http-types
               , time
  default-language: Haskell2010
  -- -N4 (not bare -N): on a 16C/32T box bare -N spawns 32 capabilities; the node
  -- uses 1-2, so ~30 idle capabilities busy-spin on the scheduler/GC barrier,
  -- burning ~4 cores at idle tip. Bounding to 4 dropped steady-state CPU from
  -- 4.23 to 0.86 cores (measured 2026-06-15) with ample parallelism for block
  -- validation. (Does NOT address the separate slow at-tip RSS growth.)
  --
  -- -I0: no idle GC. The script-check pool raises capabilities to NumCPU
  -- (setNumCapabilities 32 here), and the default idle GC (-I0.3) ran a
  -- MAJOR collection of the ~2-4 GB heap every time the node went idle for
  -- 0.3 s - i.e. between blocks and all through a download wait. Scratch,
  -- 2026-09-25, same binary and datadir, idle with a 47k-header gap
  -- (+RTS -s): default 224 major GCs / 100 GB copied / GC 447 s of 511 s
  -- CPU, 189-388 % CPU and 3.5-7k context switches/s at idle; -I0: 17 major
  -- GCs / 5.7 GB copied, 0-10 % CPU, 106-294 ctxsw/s. Over 199 connected
  -- blocks: node CPU 2,190 s -> 1,100 s at equal wall time; peak RSS
  -- 6.06 -> 7.47 GB (well inside the unit's 12 G MemoryMax). Live
  -- mainnet showed the same signature: ~144 % CPU, ~18k ctxsw/s, spread
  -- over ~30 threads at 3-4 % each, with little I/O.
  ghc-options:     -Wall -threaded -rtsopts "-with-rtsopts=-N4 -I0"

